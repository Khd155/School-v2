# اتصال قاعدة البيانات (PostgreSQL). في Supabase استخدم رابط الـ pooler (Transaction mode, port 6543).
DATABASE_URL=postgres://user:password@host:6543/postgres

# كلمة مرور المعلم الأولية (12 حرفًا على الأقل). تُستخدم مرة واحدة عند أول دخول ثم تُحفظ مشفرة.
ADMIN_PASSWORD=

# مفتاح عشوائي طويل لتوقيع جلسات أولياء الأمور (32 بايت على الأقل). مثال: openssl rand -base64 48
SESSION_SECRET=
